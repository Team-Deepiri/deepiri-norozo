# Deepiri Norozo — Discord bot
DISCORD_TOKEN=                            # or DISCORD_BOT_TOKEN
GITHUB_PAT=
GITHUB_ORG=team-deepiri
GITHUB_SUPPORT_TEAM_SLUG=support-team
GITHUB_IT_TEAM_SLUG=it-management-team

# Plaky — real API (X-API-Key, https://api.plaky.com/v1/public)
PLAKY_API_KEY=plk_...                     # from Plaky → Preferences → Advanced → Manage API keys
PLAKY_API_TOKEN=                          # alias for PLAKY_API_KEY
PLAKY_API_BASE=https://api.plaky.com/v1/public

# Plaky headless bridge — 100% background, no GUI
# Platform service at deepiri-platform/platform-services/backend/deepiri-plaky-bridge
# Runs headless Chromium, automates invite/kick (real API has no invite/kick endpoint)
PLAKY_BRIDGE_URL=http://plaky-bridge:5009
# Or via gateway: https://platform.deepiri.com/api/plaky
INTERNAL_SERVICE_SECRET=                  # must match platform INTERNAL_SERVICE_SECRET

# Discord channel/role IDs (see main.py)
STAFF_CHANNEL_ID=
PR_CHANNEL_ID=
QA_CHANNEL_ID=
DEV_TEAM_ROLE_ID=
AVAILABLE_ROLE_ID=
STAFF_ROLE_ID=

# Webhooks
PLAKY_WEBHOOK_SECRET=
PORT=8080
